/* --- CONFIGURACIÓN DE COLORES --- */
:root {
    --clr-pokedex: #dc0a2d;
    --clr-bg: #f0f2f5;
    --clr-white: #ffffff;
    
    /* Colores Oficiales de Tipos */
    --type-normal: #A8A77A;
    --type-fire: #EE8130;
    --type-water: #6390F0;
    --type-electric: #F7D02C;
    --type-grass: #7AC74C;
    --type-ice: #96D9D6;
    --type-fighting: #C22E28;
    --type-poison: #A33EA1;
    --type-ground: #E2BF65;
    --type-flying: #A98FF3;
    --type-psychic: #F95587;
    --type-bug: #A6B91A;
    --type-rock: #B6A136;
    --type-ghost: #735797;
    --type-dragon: #6F35FC;
    --type-dark: #705746;
    --type-steel: #B7B7CE;
    --type-fairy: #D685AD;
}

/* --- ESTILO GENERAL --- */
body {
    background-color: var(--clr-bg);
    font-family: 'Poppins', sans-serif;
    color: #333;
}

/* --- HEADER POKÉDEX --- */
.pokedex-header {
    background-color: var(--clr-pokedex);
    border-bottom: 6px solid #333;
    padding-bottom: 2rem;
}

.nav-logo {
    width: 250px;
    filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.2));
}

#buscador {
    max-width: 600px;
    border-radius: 30px;
    border: 3px solid #333;
    padding: 12px 25px;
    font-weight: 600;
}

/* --- BOTONES DE FILTRO --- */
.btn-type {
    background: #fff;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    transition: 0.3s;
    border: 2px solid #333;
    padding: 6px 15px;
    box-shadow: 0 4px 0px #333;
}

.btn-type:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 0px #333;
    color: white;
}

.btn-type:active {
    transform: translateY(2px);
    box-shadow: 0 0px 0px #333;
}

/* Clases de Colores para Botones y Etiquetas */
.normal { background-color: var(--type-normal) !important; color: white; }
.fire { background-color: var(--type-fire) !important; color: white; }
.water { background-color: var(--type-water) !important; color: white; }
.electric { background-color: var(--type-electric) !important; color: white; }
.grass { background-color: var(--type-grass) !important; color: white; }
.ice { background-color: var(--type-ice) !important; color: white; }
.fighting { background-color: var(--type-fighting) !important; color: white; }
.poison { background-color: var(--type-poison) !important; color: white; }
.ground { background-color: var(--type-ground) !important; color: white; }
.flying { background-color: var(--type-flying) !important; color: white; }
.psychic { background-color: var(--type-psychic) !important; color: white; }
.bug { background-color: var(--type-bug) !important; color: white; }
.rock { background-color: var(--type-rock) !important; color: white; }
.ghost { background-color: var(--type-ghost) !important; color: white; }
.dragon { background-color: var(--type-dragon) !important; color: white; }
.dark { background-color: var(--type-dark) !important; color: white; }
.steel { background-color: var(--type-steel) !important; color: white; }
.fairy { background-color: var(--type-fairy) !important; color: white; }

#ver-todos { background-color: #333 !important; color: white; }

/* --- TARJETAS --- */
.pokemon-card {
    background: white;
    border-radius: 20px;
    padding: 25px;
    cursor: pointer;
    transition: 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 2px solid #e0e0e0;
    position: relative;
    z-index: 1;
}

.pokemon-card:hover {
    transform: scale(1.05);
    border-color: var(--clr-pokedex);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
}

.id-back {
    position: absolute;
    right: 15px;
    top: 5px;
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(0,0,0,0.05);
    z-index: -1;
}

.card-img {
    width: 140px;
    height: 140px;
    filter: drop-shadow(0 8px 8px rgba(0,0,0,0.1));
}

.poke-name {
    font-family: 'Press Start 2P', cursive;
    font-size: 0.75rem;
    margin-block: 15px;
    color: #2c3e50;
}

/* --- MODAL ESTILO POKÉDEX --- */
.modal-content {
    border-radius: 25px;
    border: 4px solid #333;
}

.modal-pokedex-header {
    background: #f8f9fa;
    border-bottom: 4px solid #333;
    padding: 30px;
}

.shiny-preview {
    background: #333;
    color: gold;
    border-radius: 15px;
    padding: 15px;
    margin-top: 15px;
}

.stat-pill {
    background: #f1f1f1;
    padding: 8px 15px;
    border-radius: 20px;
    font-weight: 700;
    border: 2px solid #333;
}

/* Ajuste Responsive */
@media (max-width: 600px) {
    .nav-logo { width: 180px; }
    .btn-type { font-size: 0.6rem; padding: 5px 10px; }
    .id-back { font-size: 2rem; }
}
/* --- ESTILO PARA LOS ICONOS DE TIPO --- */
.type-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    vertical-align: middle;
    /* Este filtro convierte el icono a color blanco para que resalte en el botón */
    filter: brightness(0) invert(1);
}

.btn-type {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    /* ... resto de tu estilo ... */
}
